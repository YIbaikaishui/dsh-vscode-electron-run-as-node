---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, url } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				margin-bottom: 3rem;
			}
			.hero h1 {
				margin-bottom: 0.5rem;
			}
			.hero p {
				margin: 0;
				font-size: 1.15rem;
				line-height: 1.7;
			}
			.post-list {
				display: flex;
				flex-direction: column;
				gap: 2rem;
				list-style-type: none;
				margin: 2rem 0 0;
				padding: 0;
			}
			.post-list li {
				border-top: 1px solid var(--gray-15);
				padding-top: 1.5rem;
			}
			.post-list h3 {
				margin: 0 0 0.35rem;
				font-size: 1.35rem;
				line-height: 1.4;
			}
			.post-list h3 a {
				text-decoration: none;
			}
			.post-list p {
				margin: 0;
			}
			.post-list .date {
				color: var(--gray-45);
				font-size: 0.9rem;
				margin-bottom: 0.6rem;
			}
			.post-list img {
				border-radius: 4px;
				margin-top: 0.75rem;
			}
			.empty {
				border: 1px dashed var(--gray-25);
				border-radius: 4px;
				color: var(--gray-45);
				padding: 2rem;
				text-align: center;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
			</section>
			<section>
				<h2>全部文章</h2>
				{
					posts.length === 0 ? (
						<p class="empty">还没有文章。</p>
					) : (
						<ul class="post-list">
							{posts.map((post) => (
								<li>
									<h3>
										<a href={url(`blog/${post.id}/`)}>{post.data.title}</a>
									</h3>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<p>{post.data.description}</p>
									{post.data.heroImage && (
										<a href={url(`blog/${post.id}/`)}>
											<Image width={720} height={360} src={post.data.heroImage} alt="" />
										</a>
									)}
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
